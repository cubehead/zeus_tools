#include <windows.h>

IDI_APP_ICON ICON "@ZEUS_WINDOWS_ICON_NATIVE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@ZEUS_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@ZEUS_BUILD_NUMBER@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zeus Tools contributors\0"
      VALUE "FileDescription", "Offline text formatter, decoder and developer toolbox\0"
      VALUE "FileVersion", "@PROJECT_VERSION@.@ZEUS_BUILD_NUMBER@\0"
      VALUE "InternalName", "zeus_tools\0"
      VALUE "OriginalFilename", "ZeusTools.exe\0"
      VALUE "ProductName", "Zeus Tools\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
